# Fruver El Granjero - Variables de Entorno (ejemplo)
VITE_WHATSAPP_NUMBER=573207141222
VITE_STORE_NAME=Fruver El Granjero
VITE_SITE_URL=https://fruver-catalogo.vercel.app
# VITE_GA4_ID=G-XXXXXXXXXX

# ------------------- Integración con GridPOS -------------------
# Solo para el endpoint /api/precios (Vercel). No llevan prefijo VITE,
# así que NO se exponen en el navegador.

# Opción 1 (recomendada): token de API estable
GRIDPOS_TOKEN=
GRIDPOS_CLIENT_SLUG=fruver-el-granjero

# Opción 2: usuario dedicado de la web (hace login y cachea el token)
GRIDPOS_EMAIL=
GRIDPOS_PASSWORD=

# Opción 3: tienda virtual publicada (opcional)
GRIDPOS_STORE_SLUG=
GRIDPOS_STORE_TOKEN=
